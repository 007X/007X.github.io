# Amazon Ads MCP runtime configuration
# SECURITY: this file contains placeholders only. Never put real secrets in Git.

AUTH_METHOD=direct
PORT=9080
HOST=0.0.0.0
REGION=na
CODE_MODE=true

# Keep V1 focused on PPC read/reporting surfaces.
AMAZON_AD_API_PACKAGES=profiles,accounts-ads-accounts,reporting-version-3,sponsored-products,sp-suggested-keywords

# BYOA credentials: inject these at runtime through the host environment or secret manager.
AMAZON_AD_API_CLIENT_ID=
AMAZON_AD_API_CLIENT_SECRET=

# For a public HTTP MCP deployment, use an inbound auth mechanism.
# MCP_INBOUND_TOKEN=

# Timeouts for asynchronous report / tool calls.
MCP_TIMEOUT=120000
MCP_REQUEST_TIMEOUT=60000
MCP_CONNECTION_TIMEOUT=10000
MCP_SERVER_REQUEST_TIMEOUT=60000
MCP_TOOL_TIMEOUT=120000
MCP_REQUEST_WARNING_THRESHOLD=10000

# Keep background task handling enabled for long-running Amazon reports.
ENABLE_TASKS=true
